# 데이터베이스 (docker compose의 PostgreSQL)
DATABASE_URL=postgresql://insight:insight@localhost:5433/insight
DATABASE_URL_TEST=postgresql://insight:insight@localhost:5433/insight_test

# GitHub API 토큰 (https://github.com/settings/tokens — read-only public이면 충분)
# 없으면 수집기는 저속 무인증 모드로 동작
GITHUB_TOKEN=

# 관리 대시보드/수집기 제어 API 게이트 토큰
ADMIN_TOKEN=change-me

# LLM (OpenAI 호환 엔드포인트 — admin UI에서 변경 가능)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.3-70b-instruct
